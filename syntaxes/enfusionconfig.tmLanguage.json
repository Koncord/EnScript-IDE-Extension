{
    "comment": [
        "This is a TextMate grammar for Enfusion Config files (.imageset, .layout).",
        "Enfusion configs are used in DayZ and other Enfusion engine games."
    ],
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Enfusion Config",
    "scopeName": "source.enfusionconfig",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#classes"
        },
        {
            "include": "#blocks"
        },
        {
            "include": "#properties"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.enfusionconfig",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.enfusionconfig",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "classes": {
            "patterns": [
                {
                    "name": "meta.class.enfusionconfig",
                    "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s+([a-zA-Z0-9_]+)?\\s*(?=\\{)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.class.enfusionconfig"
                        },
                        "2": {
                            "name": "entity.name.instance.enfusionconfig"
                        }
                    }
                }
            ]
        },
        "blocks": {
            "patterns": [
                {
                    "name": "meta.block.enfusionconfig",
                    "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(?=\\{)",
                    "captures": {
                        "1": {
                            "name": "entity.name.block.enfusionconfig"
                        }
                    }
                }
            ]
        },
        "properties": {
            "patterns": [
                {
                    "name": "meta.property.enfusionconfig",
                    "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "variable.other.property.enfusionconfig"
                        }
                    }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.enfusionconfig",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.enfusionconfig",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.enfusionconfig",
                    "match": "\\b-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
                }
            ]
        }
    }
}
